APP_NAME=KPGE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kpge
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `database` membutuhkan `php artisan queue:work` (atau service `queue` di Docker) agar email terkirim. Untuk lokal tanpa worker pakai `sync`.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email: default `log` menulis ke laravel.log. Untuk uji inbox pakai Mailpit (lihat docker-compose service `mailpit`).
# - Aplikasi & queue di dalam Docker: MAIL_HOST=mailpit, MAIL_PORT=1025 (nama service jaringan compose).
# - php artisan / browser di host mesin yang sama dengan Mailpit ter-map ke host: MAIL_HOST=127.0.0.1, MAIL_PORT=1025 (atau MAILPIT_SMTP_PORT jika diubah).
# UI Mailpit: http://localhost:8025 (default MAILPIT_UI_PORT=8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Port host untuk Mailpit (hanya dipakai docker-compose mapping)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

CURRENCY_API_KEY=

TRANSMATIC_STORAGE=file

PLAID_CLIENT_ID=
PLAID_CLIENT_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_WEBHOOK_URL=

# Opsional: publish MySQL ke host. Kosongkan = pakai default compose (127.0.0.1:3306:3306). Atur jika bentrok dengan MySQL lokal.
# DB_EXPOSE_PORT=127.0.0.1:13306:3306
DB_EXPOSE_PORT=